# Brewfile — zerobrew compatible (formulas only)
# Install all formulas: zb bundle
# Export current:       zb export -f Brewfile
#
# Casks require Homebrew: brew install --cask <name>

# ── Shell & Terminal ──────────────────────────────────────────────────────────
brew "fish"
brew "zoxide"

# ── Editor ────────────────────────────────────────────────────────────────────
brew "helix"

# ── File Management ───────────────────────────────────────────────────────────
brew "yazi"

# ── Search & Navigation ───────────────────────────────────────────────────────
brew "fd"
brew "fzf"
brew "ripgrep"
brew "ast-grep"

# ── Dev Tools ─────────────────────────────────────────────────────────────────
brew "gh"
brew "git"
brew "lazygit"
brew "pre-commit"
brew "watchman"
brew "jq"

# ── Runtime Manager ───────────────────────────────────────────────────────────
# mise replaces asdf — faster, written in Rust, same workflow
brew "mise"

# ── Languages & Runtimes ──────────────────────────────────────────────────────
brew "node"
brew "pnpm"
brew "go"
brew "uv"
brew "python@3.14"
brew "lua"
brew "rustup"

# ── Go Tools ──────────────────────────────────────────────────────────────────
brew "golangci-lint"

# ── Language Servers ──────────────────────────────────────────────────────────
brew "typescript-language-server"
brew "vscode-langservers-extracted"
brew "prettier"

# ── Database ──────────────────────────────────────────────────────────────────
brew "postgresql@16"

# ── Ruby build deps (needed for compiling Ruby via mise/asdf) ────────────────
brew "libyaml"
brew "openssl@3"

# ── CLI Utilities ─────────────────────────────────────────────────────────────
brew "1password-cli"
brew "doctl"
brew "ifstat"
brew "mas"

# ── Media ─────────────────────────────────────────────────────────────────────
brew "ffmpeg"

# ── AI & ML ───────────────────────────────────────────────────────────────────
brew "ollama"
brew "opencode"

# ── Docker CLI ────────────────────────────────────────────────────────────────
brew "docker"

# ══════════════════════════════════════════════════════════════════════════════
# Casks — zerobrew doesn't support these yet
